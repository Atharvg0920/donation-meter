PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/donation-meter
# Frontend URL that phones can reach. Use your PC's LAN IP for real phone scans, e.g. http://192.168.1.5:5173
PUBLIC_BASE_URL=http://localhost:5173
ADMIN_PASSWORD=admin123
# demo = simulated payments. Switch to razorpay after implementing that provider.
PAYMENT_MODE=demo
CLIENT_ORIGIN=*
